{
  "/api/v2/robot/capabilities/MapAnnotationsCapability": {
    "put": {
      "tags": [
        "MapAnnotationsCapability"
      ],
      "summary": "Set map annotations",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ValetudoMapAnnotation"
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "$ref": "#/components/responses/200"
        },
        "400": {
          "$ref": "#/components/responses/400"
        }
      }
    }
  },
  "/api/v2/robot/capabilities/MapAnnotationsCapability/low_clearance": {
    "put": {
      "tags": [
        "MapAnnotationsCapability"
      ],
      "summary": "Replace all manually added low-clearance areas",
      "description": "expectedAreas has to contain the areas the edit was based on. If they don't match the areas currently present on the robot, the request will be rejected.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "areas",
                "expectedAreas"
              ],
              "properties": {
                "areas": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MapAnnotationsCapabilityLowClearanceArea"
                  }
                },
                "expectedAreas": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MapAnnotationsCapabilityLowClearanceArea"
                  }
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "$ref": "#/components/responses/200"
        },
        "400": {
          "$ref": "#/components/responses/400"
        }
      }
    }
  },
  "/api/v2/robot/capabilities/MapAnnotationsCapability/properties": {
    "get": {
      "tags": [
        "MapAnnotationsCapability"
      ],
      "summary": "Get various capability-related properties",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "supportedAnnotationTypes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "lowClearanceSupported": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
